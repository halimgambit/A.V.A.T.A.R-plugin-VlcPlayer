{
	"modules": {
		"VlcPlayer": {
			"version": "1.0",
			"description": "Lecteur vidéo VLC permettant de rechercher et lire des films, séries locales, avec contrôle vocal de la lecture, pause, reprise, arrêt et volume.",
			"name": "VlcPlayer",
			"VIDEO_DIR": "C:/Users/Halim/Videos",
			"port": 8080,
			"password": "avatar",
			"defaultVolume": 70,
			"clients": {
				"Salon": {
					"host": "192.168.1.1XX"
				},
				"Cuisine": {
					"host": "192.168.1.1XX"
				},
				"Chambre": {
					"host": "192.168.1.XXX"
				}
			},
			"rules": {
				"playMovie": ["movie","video","series"],
				"closeVlc": ["(close|quit|leave|farm|exit) * vlc", "vlc * farm", "turn off vlc"],
				"pauseMovie": ["pause * (movie|film)"],
				"resumeMovie": ["(resume|resumed|continue|reading|playing) * (movie|film)"],
				"vlcVolume": ["vlc * (volume|sound)", "(volume|sound) * vlc"]
			}
		}
	},
	"cron": {
		"VlcPlayer": {
			"name": "VlcPlayer",
			"time": "0 * */2 * * *"
		}
	}
}
			